# Porta do servidor local (tablet do estande)
PORT=4400

# Token do painel do operador em /admin.html
ADMIN_TOKEN=troque-por-um-token-seu

# Fuso usado para virar o dia das cotas
TZ_EVENT=America/Sao_Paulo

# Planilha do Google: URL /exec do Web App publicado em google-apps-script/Codigo.gs
# (vazio = nao envia nada, o estande segue so com o CSV do painel)
SHEETS_WEBHOOK_URL=

# Mesmo valor da constante SEGREDO dentro do Apps Script
SHEETS_SECRET=troque-por-um-segredo-seu

# Webhook do agente (z-whitelabel) que dispara a mensagem de agradecimento,
# enviado quando o visitante termina o cadastro + giro(s) sem giros restantes.
# Se vazio, usa a URL padrao ja embutida em thankyou.js (agentIncomingWebhookId=5753).
THANKYOU_WEBHOOK_URL=
